# LabelLens Environment Configuration (Zero Paid API Architecture)

# USDA FoodData Central API Key (Optional)
# FDC offers instant free keys with 1,000 req/hour at https://fdc.nal.usda.gov/api-key-signup.html
# LabelLens works automatically out-of-the-box using the public Open Food Facts API and USDA FoodData Central public endpoints.
FDC_API_KEY="DEMO_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
